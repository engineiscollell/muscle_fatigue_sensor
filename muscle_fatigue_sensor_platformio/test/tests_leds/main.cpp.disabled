#include <Arduino.h>
#include <driver/dac.h>

#include "config.h"

// ============================================================================
// CONFIG TEST
// ============================================================================

// Intensitat ULTRA conservadora per prova inicial
constexpr uint8_t TEST_DAC_VALUE = 5;

// Temps ON/OFF
constexpr uint32_t LED_ON_MS  = 200;
constexpr uint32_t LED_OFF_MS = 980;

// ============================================================================
// HELPERS LEDs
// ============================================================================

void ledsOff()
{
    // ------------------------------------------------------------------------
    // Desactivem perifèrics DAC
    // ------------------------------------------------------------------------

    dacDisable(PIN_LED_IR); // GPIO25 -> IR
    dacDisable(PIN_LED_RED); // GPIO26 -> RED

    // ------------------------------------------------------------------------
    // IMPORTANT:
    // Forcem els pins a LOW real (no alta impedància)
    // ------------------------------------------------------------------------

    pinMode(PIN_LED_RED, OUTPUT);
    digitalWrite(PIN_LED_RED, LOW);

    pinMode(PIN_LED_IR, OUTPUT);
    digitalWrite(PIN_LED_IR, LOW);
}

/*
